# Prahari live pipeline — copy to .env (git-ignored) and adjust.
PRAHARI_INGEST_TOKEN=dev-token       # Bearer token collectors must send to /api/ingest
WARMUP_SECONDS=180                    # learn "normal" for this long before scoring
CORR_WINDOW_SECONDS=300              # correlation sliding window
ANOMALY_QUANTILE=0.99               # threshold quantile on warmup scores
STATE_DIR=./state                    # persisted baseline (survives restart; never re-learns)

# Attribution (local / air-gapped)
PRAHARI_CHAT_MODEL=qwen2.5:7b
OLLAMA_HOST=http://localhost:11434
# CORPUS_PATH defaults to <repo>/corpus/attack_techniques.json
